# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# build output
/dist/
/.vite/
/.tanstack/

# Leftovers from before the TanStack Start migration — nothing produces these
# any more, but old checkouts still have them and they should stay invisible.
/.next/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
*.log
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which setup tells you to copy. `.env*` had been
# swallowing it, so `cp .env.example .env.local` failed on a fresh clone.
!.env.example

# database
*.db
*.db-wal
*.db-shm

# vercel
.vercel

# typescript
*.tsbuildinfo

# ide
.idea/
